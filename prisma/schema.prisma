// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js models (User/Account/Session/VerificationToken shape it expects) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  /// Rolling AI-compiled summary of this user's past conversations, injected
  /// into the chat system prompt so the assistant carries context across sessions.
  memory        String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  chatSessions      ChatSession[]
  chatFolders       ChatFolder[]
  verificationCodes EmailVerificationCode[]
  holdings          Holding[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Custom sign-up email verification (5-digit code) ---

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Chat persistence (mirrors the localStorage ChatSession shape used for guests) ---

model ChatFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions ChatSession[]

  @@index([userId])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  folderId  String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   ChatFolder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages ChatMessageRecord[]

  @@index([userId])
  @@index([folderId])
}

model ChatMessageRecord {
  id            String   @id @default(cuid())
  chatSessionId String
  role          String
  content       String
  /// JSON-serialized ToolCard[] / ResearchTrailEntry[] — kept as text since
  /// this app treats them as opaque client-rendered payloads, not query targets.
  toolCardsJson String?
  trailJson     String?
  isAdvice      Boolean  @default(false)
  createdAt     DateTime @default(now())

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
}

// --- Portfolio holdings (mirrors the localStorage Holding shape used for guests) ---

model Holding {
  id     String @id @default(cuid())
  userId String
  ticker String
  shares Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
}
